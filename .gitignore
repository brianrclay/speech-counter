# Regenerated by `npm run build` from index.html/css/main.js/assets -
# Capacitor's own native-project gitignores already exclude the copies
# it makes of this into ios/ and android/.
www/

# Release signing - never commit the upload keystore or its passwords.
# Losing this file means losing the ability to publish updates under the
# same Play Store listing, so back it up somewhere outside git.
android/keystore.properties
android/*.jks
android/*.keystore

